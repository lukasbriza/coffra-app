auto-install-peers=false
strict-peer-dependencies=true
save-exact=true
enable-pre-post-scripts=true

# React Native / Metro needs a flatter node_modules to resolve the toolchain and
# native-module autolinking. We hoist ONLY those packages to the workspace root and
# keep pnpm's strict isolation for everything else (web/nest still catch phantom
# deps). Setting public-hoist-pattern overrides pnpm's default, so the default
# eslint/prettier hoists are re-declared here.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=scheduler
