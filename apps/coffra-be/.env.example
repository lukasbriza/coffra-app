# Validated at startup (src/modules/config/env.validation.ts) — the app will not start
# when a required variable is missing or invalid.

# --- App ---
# NODE_ENV: development | production | test (default: development)
NODE_ENV=development
# PORT: 1-65535 (default: 3000)
PORT=3000

# --- Database (required) ---
# Matches the dev Postgres from `pnpm infra:up` (docker/docker-compose.yaml).
DATABASE_URL="postgresql://coffra:coffra@localhost:5439/coffra_dev?schema=public"

# --- OIDC provider (all required) ---
# Values below match the dev realm from `pnpm infra:up` (docker/keycloak/coffra-realm.json).
# The client secret is a public dev value — use your own for any real IdP.
OIDC_ISSUER_URL="http://localhost:8080/realms/coffra"
OIDC_CLIENT_ID="coffra-be"
OIDC_CLIENT_SECRET="coffra-dev-secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- Secrets (required, min 32 chars, all three must differ) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
# Signs the short-lived cookie that carries the OIDC login checks (state, nonce, PKCE verifier).
AUTH_CHECKS_SECRET="change-me-checks-secret-at-least-32-chars"
# TTLs in seconds (defaults: 900 = 15 min, 2592000 = 30 days).
# The refresh TTL is the longest session counted from the login: a refresh keeps the original end (ADR 0010).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- HTTP hardening (all optional) ---
# CORS_ORIGINS: browser origins allowed to call the API, comma separated, each exactly as a browser sends it
# (scheme://host[:port], lower case, no path, no trailing slash, no default port, no *). Empty: the API sends no CORS
# headers at all. Example: CORS_ORIGINS="https://coffra.example.com,http://localhost:5173"
CORS_ORIGINS=
# TRUST_PROXY_HOPS: number of reverse proxies in front of the app (0-10, default 0). The rate limit counts the client
# address, so it must be right in both directions: 0 behind a proxy makes every client look like the proxy (one shared
# limit), a number higher than the real count lets a client choose its address with X-Forwarded-For (no limit at all).
# One proxy (Traefik, nginx, Caddy) in front of the container: 1.
TRUST_PROXY_HOPS=0
# Rate limit per client address: a window of RATE_LIMIT_TTL_SECONDS, at most RATE_LIMIT_MAX requests to any route and
# RATE_LIMIT_AUTH_MAX to the login routes together (login, callback, refresh, logout). /api/health is not limited.
# The counters are in Redis (REDIS_URL, below), however many replicas run.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
# SWAGGER_ENABLED: true | false. Left out: the Swagger UI (/api/swagger) and the OpenAPI document (/api/swagger-json)
# are served outside production and not in production (NODE_ENV=production).
SWAGGER_ENABLED=

# --- Redis (required) ---
# Keeps the rate limit counters, one replica or many (redis:// or rediss://; the URL may hold a password).
# A required service, like the database: while Redis does not answer, counted requests are refused with 503 and
# /api/health reports it. The app connects with the first command. Matches the dev Redis from `pnpm infra:up`.
REDIS_URL="redis://localhost:6389"
