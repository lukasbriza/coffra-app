# Validated at startup (src/modules/config/env.validation.ts) — the app will not start
# when a required variable is missing or invalid.

# --- App ---
# NODE_ENV: development | production | test (default: development)
NODE_ENV=development
# PORT: 1-65535 (default: 3000)
PORT=3000

# --- Database (required) ---
# Matches the dev Postgres from `pnpm infra:up` (docker/docker-compose.yaml).
DATABASE_URL="postgresql://coffra:coffra@localhost:5439/coffra_dev?schema=public"

# --- OIDC provider (all required) ---
# Values below match the dev realm from `pnpm infra:up` (docker/keycloak/coffra-realm.json).
# The client secret is a public dev value — use your own for any real IdP.
OIDC_ISSUER_URL="http://localhost:8080/realms/coffra"
OIDC_CLIENT_ID="coffra-be"
OIDC_CLIENT_SECRET="coffra-dev-secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- Secrets (required, min 32 chars, all three must differ) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
# Signs the short-lived cookie that carries the OIDC login checks (state, nonce, PKCE verifier).
AUTH_CHECKS_SECRET="change-me-checks-secret-at-least-32-chars"
# TTLs in seconds (defaults: 900 = 15 min, 2592000 = 30 days)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
