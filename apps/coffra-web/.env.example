NEXT_PUBLIC_META_ROBOTS="noindex, nofollow"

# Server only (never NEXT_PUBLIC_): the browser does not call the API, the Next server does.
# Origin of the coffra API (apps/coffra-be), without a path: the API paths already start with /api/.
# Locally that is coffra-be from `pnpm --filter @lukasbriza/coffra-be dev` on port 3000 (this app runs on 3001).
# Required by `next dev` and `next start`; `next build` does not read it.
API_BASE_URL="http://localhost:3000"
